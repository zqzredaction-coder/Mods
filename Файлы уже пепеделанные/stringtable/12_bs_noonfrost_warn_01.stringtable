  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"Ни шагу дальше!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"Уходи отсюда, и не заходи ни в какие двери. Залы за нами принадлежат Римрганду и тем, кто ему предан – там даже соски у стражи не твердеют".</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
