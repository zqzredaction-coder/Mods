<?xml version="1.0" encoding="utf-8"?>
<StringTableFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>conversations\00_dyrwood\00_bs_rumbald</Name>
  <NextEntryID>1</NextEntryID>
  <EntryCount>3</EntryCount>
  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"Я этой твари голову на копье насажу, помяни мое слово!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"Будь проклят Галавэйн за таких монстров, и будь прокляты другие боги тоже! И пусть их жёны трахаются с кем попало!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>3</ID>
      <DefaultText>"...разрушил мой загон! Даже не потрудился открыть ворота..."</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
</StringTableFile>