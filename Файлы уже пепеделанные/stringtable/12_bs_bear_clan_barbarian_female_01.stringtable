<?xml version="1.0" encoding="utf-8"?>
<StringTableFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>conversations\12_oldsong\12_bs_bear_clan_barbarian_female_01</Name>
  <NextEntryID>1</NextEntryID>
  <EntryCount>3</EntryCount>
  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"Только трусы прячутся в пещерах, когда предстоит бой".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"Галавэйн благоволит мощи и грубой силе – и большим хуям".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>3</ID>
      <DefaultText>Жесткие и неухоженные волосы варварки ниспадают с ее плеч.</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
</StringTableFile>