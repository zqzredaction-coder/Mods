<?xml version="1.0" encoding="utf-8"?>
<StringTableFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>conversations\07_gilded_vale\07_bs_raedric_men_generic</Name>
  <NextEntryID>1</NextEntryID>
  <EntryCount>14</EntryCount>
  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"Проникновение!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"На нас напали!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>4</ID>
      <DefaultText>"Тревога! Тревога!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>5</ID>
      <DefaultText>"У нас гости!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>6</ID>
      <DefaultText>"Поосторожнее здесь".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>7</ID>
      <DefaultText>"Да поможет нам мудрость Бераса! – и пусть Бледная Рыцарь нас приласкает!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>8</ID>
      <DefaultText>"Прошу прощения. Я на посту".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>9</ID>
      <DefaultText>"От этой анимансерки из подземелья у меня мурашки по коже!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>10</ID>
      <DefaultText>"Редрик выведет нас. Он сильный лидер".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>11</ID>
      <DefaultText>"Не важно, кто сидит на троне. Мы будем исполнять свой долг".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>12</ID>
      <DefaultText>"Как будто нам за это заплатят..."</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>13</ID>
      <DefaultText>"Смотри, куда идешь".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>14</ID>
      <DefaultText>"Мы не забудем тех, кто пал от твоей руки, чужеземец".</DefaultText>
      <FemaleText>"Мы не забудем тех, кто пал от твоей руки, чужеземка".</FemaleText>
    </Entry>
    <Entry>
      <ID>15</ID>
      <DefaultText>"Только благодаря лорду Редрику твоя голова все еще на плечах".</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
</StringTableFile>