      <FemaleText />
    </Entry>
    <Entry>
      <ID>776</ID>
      <DefaultText>Темное печенье рауатай</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>777</ID>
      <DefaultText>Блюдо из яйца дракона</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>778</ID>
      <DefaultText>Блюдо из мяса дракона</DefaultText>
      <FemaleText />
    </Entry>
