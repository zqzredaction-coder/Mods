      <FemaleText />
    </Entry>
    <Entry>
      <ID>206</ID>
      <DefaultText>Двойственность смертного присутствия – Отклонение</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>207</ID>
      <DefaultText>Двойственность смертного присутствия – другие виды защиты</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>208</ID>
      <DefaultText>Путь флагелланта</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>209</ID>
