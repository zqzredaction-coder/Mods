  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"Мы помним, как ты прикончил Индана и Орноса... эстрамор".</DefaultText>
      <FemaleText>"Мы помним, как ты прикончила Индана и Орноса... эстрамор".</FemaleText>
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"За Галавэйна и кровь его героев! И большой гон!"</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
