<?xml version="1.0" encoding="utf-8"?>
<StringTableFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>conversations\11_hearthsong\11_cv_sacrificial_crib</Name>
  <NextEntryID>1</NextEntryID>
  <EntryCount>3</EntryCount>
  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>[Взять Велу.]</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>[Уйти, виляя задом.]</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>3</ID>
      <DefaultText>В колыбели лежит крошечный орланский младенец, покрытый темной шерстью. Девочка спит – глаза ее закрыты, но при этом она ерзает под одеялом и трется носом о подушку.</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
</StringTableFile>