  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>Липкие нити паутины закрывают вход в туннель, но между ними теперь можно пройти.</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>[Войти в туннель.]</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>3</ID>
      <DefaultText>[Уйти, виляя задом.]</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
