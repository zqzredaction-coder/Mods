      <ID>733</ID>
      <DefaultText>Холодные Ходоки</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>734</ID>
      <DefaultText>Даркоцци Паладини</DefaultText>
      <FemaleText />
    </Entry>
