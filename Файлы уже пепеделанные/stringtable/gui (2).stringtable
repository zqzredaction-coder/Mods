    <Entry>
      <ID>600</ID>
      <DefaultText>Вайлианское посольство</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>601</ID>
      <DefaultText>Быстрое сохранение создано.</DefaultText>
      <FemaleText />
    </Entry>
