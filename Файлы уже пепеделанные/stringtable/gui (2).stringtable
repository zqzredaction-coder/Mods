      <ID>1776</ID>
      <DefaultText>Упреждение: {0}</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>1777</ID>
      <DefaultText>Слабо {0}</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>1778</ID>
      <DefaultText>Слегка {0}</DefaultText>
      <FemaleText />
    </Entry>
