    <Entry>
      <ID>156</ID>
      <DefaultText>Тяжелый</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>157</ID>
      <DefaultText>Принять</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>158</ID>
      <DefaultText>Отмена</DefaultText>
      <FemaleText />
