      <FemaleText />
    </Entry>
    <Entry>
      <ID>1773</ID>
      <DefaultText>Хорхе Салгадо</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>1774</ID>
      <DefaultText>Старший дизайнер</DefaultText>
      <FemaleText />
    </Entry>
