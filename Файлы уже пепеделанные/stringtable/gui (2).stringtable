      <FemaleText />
    </Entry>
    <Entry>
      <ID>582</ID>
      <DefaultText>Герцогский дворец</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>583</ID>
      <DefaultText>Храм Воедики – застенок госпожи</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>584</ID>
      <DefaultText>Башня</DefaultText>
      <FemaleText />
    </Entry>
