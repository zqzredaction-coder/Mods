<?xml version="1.0" encoding="utf-8"?>
<StringTableFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>conversations\07_gilded_vale\07_bs_villagers_kolsc_raedric_dead</Name>
  <NextEntryID>1</NextEntryID>
  <EntryCount>5</EntryCount>
  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"Что нам делать? Колш и Редрик мертвы".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"Берас побери их обоих. Так даже лучше. Пусть Бледная Рыцарь берёт обоих".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>3</ID>
      <DefaultText>"Пока гланфатанцы не повалят из лесов".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>4</ID>
      <DefaultText>"К нам пришлют нового сейна или сейноу, да? В смысле, герцога".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>5</ID>
      <DefaultText>"Ты разве не слышал? Он мертв! Черти что творится".</DefaultText>
      <FemaleText>"Ты разве не слышала? Он мертв! Черти что творится".</FemaleText>
    </Entry>
  </Entries>
</StringTableFile>