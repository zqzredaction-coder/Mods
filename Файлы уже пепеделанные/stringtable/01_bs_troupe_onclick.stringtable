<?xml version="1.0" encoding="utf-8"?>
<StringTableFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>conversations\01_defiance_bay_copperlane\01_bs_troupe_onclick</Name>
  <NextEntryID>1</NextEntryID>
  <EntryCount>9</EntryCount>
  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"...и так – ага...Да?"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"...Смотри-ка! Усталый путешественник, пришедший на звуки флейты!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>3</ID>
      <DefaultText>"Получилось! Чары сработали! Хайлиа улыбнулась нам! Теперь актрисы раздвигают ноги охотнее!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>4</ID>
      <DefaultText>"Мои бедные уши..."</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>5</ID>
      <DefaultText>"Спасибо за помощь, теперь можешь идти со сцены..."</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>7</ID>
      <DefaultText>"...итак, эээ... так вот, кажется, наши зрители хотят разглядеть все поподробнее!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>8</ID>
      <DefaultText>"Уйди-ка назад в зал!"</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>9</ID>
      <DefaultText>"Мы тут в спектакле играть пытаемся, друг!"</DefaultText>
      <FemaleText>"Мы тут в спектакле играть пытаемся, подруга!"</FemaleText>
    </Entry>
    <Entry>
      <ID>10</ID>
      <DefaultText>"По крайней мере, один из нас..."</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
</StringTableFile>