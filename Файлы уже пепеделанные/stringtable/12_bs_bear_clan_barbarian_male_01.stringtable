<?xml version="1.0" encoding="utf-8"?>
<StringTableFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Name>conversations\12_oldsong\12_bs_bear_clan_barbarian_male_01</Name>
  <NextEntryID>1</NextEntryID>
  <EntryCount>3</EntryCount>
  <Entries>
    <Entry>
      <ID>1</ID>
      <DefaultText>"Честный открытый бой – единственное настоящее испытание силы".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>2</ID>
      <DefaultText>"В Чреве укрывается беззубая охотница на склоне лет – это оскорбление для Галавэйна – старуха, не способная ни раздвинуть ноги, ни охотиться".</DefaultText>
      <FemaleText />
    </Entry>
    <Entry>
      <ID>3</ID>
      <DefaultText>Варвар не сводит с вас горящих едва сдерживаемой яростью глаз.</DefaultText>
      <FemaleText />
    </Entry>
  </Entries>
</StringTableFile>